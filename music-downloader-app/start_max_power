@echo off
title SoundWave Turbo Downloader [8x Parallel Mode]
echo ===================================================================
echo     SoundWave - MAX POWER 8x TURBO DOWNLOADER (Python 3.13)
echo ===================================================================
echo.

cd /d "%~dp0backend"

echo [1/3] Updating backend dependencies...
py -3.13 -m pip install -r requirements.txt --quiet

echo.
echo [2/3] Verifying FFmpeg audio engine...
py -3.13 -m spotdl --download-ffmpeg

echo.
echo [3/3] Starting server on http://127.0.0.1:8000 ...
start "" "http://127.0.0.1:8000"

py -3.13 -m uvicorn main:app --host 127.0.0.1 --port 8000

pause
